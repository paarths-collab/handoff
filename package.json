{
  "name": "handoff",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint apps packages scripts",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "package:mac": "sh scripts/package-mac.sh",
    "check-manifest": "tsx scripts/check-manifest.ts",
    "check-anon": "tsx scripts/check-anon.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm check-manifest && pnpm check-anon && pnpm check-workflows && pnpm audit --prod --audit-level high",
    "e2e": "playwright test",
    "mutation": "vitest run packages/core/test/engine.test.ts -t \"parses 5,000 tabs\" && stryker run",
    "format": "biome format --write apps packages scripts",
    "format:check": "biome format apps packages scripts",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "check-workflows": "tsx scripts/check-workflows.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
