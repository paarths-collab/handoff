{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Handoff",
	"version": "1.0.0",
	"identifier": "local.handoff.desktop",
	"build": {
		"beforeDevCommand": "pnpm exec vite --host 127.0.0.1 --port 1420 --strictPort",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "pnpm exec vite build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Handoff",
				"width": 560,
				"height": 740,
				"minWidth": 440,
				"minHeight": 560,
				"theme": "Dark",
				"backgroundColor": "#000000"
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "Productivity",
		"shortDescription": "Move your Arc sidebar locally",
		"macOS": {
			"signingIdentity": "-"
		}
	}
}
