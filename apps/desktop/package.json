{
	"name": "@handoff/desktop",
	"version": "1.0.3",
	"license": "MIT",
	"type": "module",
	"private": true,
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"@handoff/core": "workspace:*",
		"@handoff/ui": "workspace:*",
		"@tauri-apps/api": "2.12.4"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"bundle:mac": "RUSTFLAGS=\"--remap-path-prefix=$HOME=/build-home --remap-path-prefix=$(cd ../.. && pwd)=/build\" tauri build --target universal-apple-darwin --bundles app",
		"bundle:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis"
	}
}
